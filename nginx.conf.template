server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 15 MB de PDF + margen para el multipart.
    client_max_body_size 16m;

    # Mismo origen: el front llama a /api/* y nginx lo reenvía al backend.
    # API_UPSTREAM se inyecta por entorno al arrancar el contenedor (12-Factor III).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # La extracción puede tardar: el backend corta a los 30s.
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
